# Copy this file to .env and fill in local development values.
# Never place service_role, secret, database password, or owner credentials in this mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Cloudflare Stream (video upload + playback)
EXPO_PUBLIC_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token

# Cloudflare R2 — NOT USED.
#
# Deliberately absent. There is no R2 integration in this codebase: no S3
# client, no endpoint, no bucket call anywhere. All object storage is Supabase
# Storage (buckets: user-files, channel-media, channel-videos) and all video is
# Cloudflare Stream. See docs/R2_AND_STREAM_AUDIT_2026-09-06.md.
#
# The keys that used to sit here were live credentials for a service nothing
# contacts. If R2 is ever actually adopted, mint fresh keys then and put them in
# Supabase Edge Function secrets — never here, because anything reachable from
# this file is one EXPO_PUBLIC_ prefix away from being inlined into the bundle.
