# Copy this file to .env and fill in local development values.
# Never place service_role, secret, database password, or owner credentials in this mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Cloudflare Stream (video upload + playback)
EXPO_PUBLIC_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token

# Cloudflare R2 (storage)
EXPO_PUBLIC_CLOUDFLARE_R2_BUCKET=your_r2_bucket_name
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# UPI payment address shown to users (public merchant payment address, not a secret).
# Takes priority over app.json's extra.UPI_ID when set. Falls back to app.json for dev.
EXPO_PUBLIC_UPI_ID=your_upi_id@bank
