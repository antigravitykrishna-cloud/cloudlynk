{
  "expo": {
    "name": "Cloudlynk",
    "slug": "cloudlynk",
    "version": "0.7.11",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "cloudlynk",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cloudlynk.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cloudlynk needs access to your video library to upload content to your channel.",
        "NSCameraUsageDescription": "Cloudlynk needs camera access to record videos for your channel.",
        "NSMicrophoneUsageDescription": "Cloudlynk needs microphone access for video recording."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.cloudlynk.app",
      "versionCode": 18,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "com.android.vending.BILLING"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thecloudlynk.com",
              "pathPrefix": "/c"
            },
            {
              "scheme": "https",
              "host": "www.thecloudlynk.com",
              "pathPrefix": "/c"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cloudlynk needs access to your photos to back them up to the cloud.",
          "cameraPermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-video",
      "./plugins/withRemoveAndroidPermissions.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "APP_ENV": "production",
      "IAP_PROVIDER": "noop",
      "GOOGLE_PLAY_PACKAGE_NAME": "com.cloudlynk.app",
      "RECEIPT_VERIFIER_URL": "https://wdtwjiixuueqejfraaod.supabase.co/functions/v1/verify-play-receipt",
      "META_APP_ID": "",
      "META_CLIENT_TOKEN": "",
      "SUPPORT_EMAIL": "help.cupibs@gmail.com",
      "PRIVACY_POLICY_URL": "https://thecloudlynk.com/privacy-policy",
      "TERMS_URL": "https://thecloudlynk.com/terms",
      "COMMUNITY_GUIDELINES_URL": "https://thecloudlynk.com/guidelines",
      "REFUND_POLICY_URL": "https://thecloudlynk.com/refund",
      "COPYRIGHT_POLICY_URL": "https://thecloudlynk.com/copyright",
      "GEO_CHECK_WORKER_URL": "",
      "router": {},
      "eas": {
        "projectId": "4224a968-e720-43b6-92a8-c26458f2a7a0"
      }
    },
    "owner": "southern-methodist-university"
  }
}
